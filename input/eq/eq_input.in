units real
atom_style full
boundary f f f

pair_style lj/cut/coul/cut 12.0
pair_modify mix arithmetic
bond_style harmonic
angle_style harmonic
dihedral_style opls
improper_style cvff
special_bonds lj/coul 0.0 0.0 0.5
neighbor 2.0 bin
neigh_modify every 1 delay 0 check yes

read_restart ${directory_input}/${directory_nve}/${filename_restart_nve}.${index}

timestep 1.0

compute myCom all com
compute myRg all gyration
variable rCM equal sqrt(c_myCom[1]^2 + c_myCom[2]^2 + c_myCom[3]^2)

run 0

variable cx equal c_myCom[1]
variable cy equal c_myCom[2]
variable cz equal c_myCom[3]
variable dx equal -v_cx
variable dy equal -v_cy
variable dz equal -v_cz
displace_atoms all move v_dx v_dy v_dz units box

velocity all zero linear
velocity all zero angular

# fix F_mom all momentum 100 linear 1 1 1 angular

fix F_NVE all nve

reset_timestep 0

dump dump_eq all custom ${dt_eq} ${directory_data}/${directory_eq}/${filename_traj_eq}_${index}.lammpstrj id type x y z xu yu zu vx vy vz ix iy iz
dump_modify dump_eq sort id

thermo_style custom step temp pe ke etotal press v_rCM c_myRg
thermo 1000

run ${t_eq}